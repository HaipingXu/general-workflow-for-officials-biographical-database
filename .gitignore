# Environment
.env
.env.*
!.env.example

# Plans (local only — not version-controlled)
plan/

# Python cache

__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Scraped biographies (tracked for reproducibility)
# officials/

# Output files (generated)
output/*.xlsx
output/*.json

# Log/intermediate JSON results (regeneratable)
logs/*/
logs/*.json
logs/*.log

# Temp scratch / backups / dry-run reports
temp/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
.claude/

# Large data files
data/*.json
data/*.xlsx

# Slides (local only, not for version control)
Slides/
slides/

eval/


# Streamlit secrets（真实密钥绝不入库；只提交 .example）
.streamlit/secrets.toml
output/cleaned/

# review_app: 代码与通用文档已发布；以下为本地/部署专属，绝不入库
# （.gitignore 不支持行尾注释，注释须独立成行）
review_app/*.log
# 本地 CSV 回退后端的落盘
review_app/edits/
# 内部运维交接（线上 Supabase 坐标/账号/踩坑），含敏感信息，不发布
review_app/DEPLOYMENT_INFO.md
