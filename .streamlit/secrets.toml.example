# 复制本文件为 .streamlit/secrets.toml（本地，已被 .gitignore 忽略）
# 或在 Streamlit Community Cloud 的 App → Settings → Secrets 里粘贴同样内容。
#
# 千万不要把真实的 secrets.toml 提交到 git！

# 全组共享访问密码
app_password = "改成你们的团队密码"

# Supabase 后端（不配则自动回退本地 CSV）
[supabase]
url = "https://your-project.supabase.co"
key = "your-service_role-or-anon-key"
